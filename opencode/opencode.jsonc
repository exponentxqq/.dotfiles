{
  "$schema": "https://opencode.ai/config.json",
  "model": "xiaomi-token-plan-cn/mimo-v2.5-pro",
  "permission": "allow",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "agent": {
    "plan": {
      "model": "zai-coding-plan/glm-5.3",
      "temperature": 1.0,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
      },
    },
    "build": {
      "model": "opencode/muse-spark-1.2-contributor-free",
      "temperature": 0.0,
      "variant": "max",
    },
    "general": {
      "model": "opencode-go/gpt-5.6-luna",
      "temperature": 0.1,
    },
    "title": {
      "model": "opencode-go/minimax-m3",
    },
    "compaction": {
      "model": "xiaomi-token-plan-cn/mimo-v2.5-pro",
    },
    "summary": {
      "model": "xiaomi-token-plan-cn/mimo-v2.5-pro",
    },
  },
  "lsp": {
    "gopls": {
      "command": ["/home/xuqinqin/develop/docker/bin/gopls"],
    },
    "rust": {
      "command": ["/home/xuqinqin/develop/docker/bin/rust-analyzer"],
    },
    "pyright": {
      "disabled": true,
    },
    "jdtls": {
      "command": [
        "/home/xuqinqin/.local/share/nvim/mason/packages/jdtls/bin/jdtls",
        "--jvm-arg=-Xmx1g",
        "--jvm-arg=-XX:MaxMetaspaceSize=384m",
        "--jvm-arg=-XX:+UseG1GC",
      ],
      "env": {
        "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk",
      },
    },
  },
  "mcp": {
    "zai-mcp-server": {
      "type": "local",
      "command": ["npx", "-y", "@z_ai/mcp-server"],
      "environment": {
        "Z_AI_API_KEY": "{env:GLM_API_KEY}",
        "Z_AI_MODE": "ZAI",
      },
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": ["codebase-memory-mcp"],
    },
    "dbx-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@dbx-app/mcp-server"],
      "environment": {
        "DBX_WEB_URL": "http://localhost:4224",
      },
    },
  },
}
